#!/usr/bin/env bash
set -euo pipefail

# Validate that IBM Cloud CLI is installed
if ! command -v ibmcloud &> /dev/null; then
    echo "❌ IBM Cloud CLI not found!"
    echo "Please install it following the instructions at:"
    echo "https://cloud.ibm.com/docs/cli?topic=cli-install-ibmcloud-cli"
    exit 1
fi

# Check if already logged in by looking for account field in JSON output
LOGIN_REQUIRED=true
if TARGET_JSON=$(ibmcloud target --output json 2>/dev/null); then
    if echo "$TARGET_JSON" | grep -q "\"account\""; then
        echo "✅ Already logged in to IBM Cloud"
        LOGIN_REQUIRED=false
    else
        echo "Not logged in to IBM Cloud. Login required."
    fi
else
    echo "Unable to determine login status. Will attempt login."
fi

# Only prompt for API key if login is required and not already set in environment
if [ "$LOGIN_REQUIRED" = true ]; then
    if [ -z "${IBMCLOUD_API_KEY:-}" ]; then
        echo "Please enter your IBM Cloud API key (input will be hidden):"
        read -s IBMCLOUD_API_KEY
        echo
    else
        echo "Using IBM Cloud API key from environment variable"
    fi
fi

# Prompt for Resource Group
echo "Please enter the IBM Cloud Resource Group to use (default: default):"
read RESOURCE_GROUP
RESOURCE_GROUP=${RESOURCE_GROUP:-default}

# Prompt for Container Registry namespace
echo "Please enter the IBM Container Registry namespace to use (default: k8s-visualizer):"
read IBM_CR_NAMESPACE
IBM_CR_NAMESPACE=${IBM_CR_NAMESPACE:-k8s-visualizer}

# Prompt for Image Name
echo "Please enter the image name to use (default: k8s-visualizer):"
read IMAGE_NAME
IMAGE_NAME=${IMAGE_NAME:-k8s-visualizer}

# Prompt for cluster name
echo "Please enter your IKS cluster name or ID:"
read CLUSTER_NAME

# Set the full image path using the IBM Cloud convention
ICR_REGION="us.icr.io"
ICR_IMAGE="${ICR_REGION}/${IBM_CR_NAMESPACE}/${IMAGE_NAME}:latest"

echo
echo "Configuration Summary:"
echo "  Resource Group: ${RESOURCE_GROUP}"
echo "  Container Registry Namespace: ${IBM_CR_NAMESPACE}"
echo "  Image Name: ${IMAGE_NAME}"
echo "  Full Image Path: ${ICR_IMAGE}"
echo "  Cluster Name: ${CLUSTER_NAME}"
echo

# Login to IBM Cloud if required
if [ "$LOGIN_REQUIRED" = true ]; then
    echo "Logging in to IBM Cloud..."
    ibmcloud login --apikey "$IBMCLOUD_API_KEY" -g "${RESOURCE_GROUP}" || {
        echo "❌ Login failed. Please check your API key and try again."
        exit 1
    }
fi

# Target the resource group
echo "Targeting resource group: ${RESOURCE_GROUP}..."
ibmcloud target -g "${RESOURCE_GROUP}"

# Install required plugins if not already installed
if ! ibmcloud plugin show container-registry &> /dev/null; then
    echo "Installing IBM Cloud Container Registry plugin..."
    ibmcloud plugin install container-registry -f
fi

if ! ibmcloud plugin show container-service &> /dev/null; then
    echo "Installing IBM Cloud Kubernetes Service plugin..."
    ibmcloud plugin install container-service -f
fi

# Create Container Registry namespace if it doesn't exist
echo "Setting up Container Registry namespace..."
ibmcloud cr namespace-add "${IBM_CR_NAMESPACE}" || true

# Set Kubernetes cluster context
echo "Configuring access to Kubernetes cluster: ${CLUSTER_NAME}..."
ibmcloud ks cluster config --cluster "${CLUSTER_NAME}"

# Verify connection to the cluster
echo "Verifying connection to Kubernetes cluster..."
if kubectl get nodes &> /dev/null; then
    echo "✅ Successfully connected to Kubernetes cluster"
else
    echo "❌ Failed to connect to Kubernetes cluster. Please check cluster name and permissions."
    exit 1
fi

# Export the variables to a configuration file that can be sourced by other scripts
mkdir -p .ibm
cat > .ibm/config.sh << EOF
#!/usr/bin/env bash
# IBM Cloud configuration - Auto-generated by ibm-setup script

# Resource group
export RESOURCE_GROUP="${RESOURCE_GROUP}"

# Container Registry settings
export IBM_CLOUD_REGION="us-south"
export IBM_CONTAINER_REGISTRY="${ICR_REGION}"
export IBM_CR_NAMESPACE="${IBM_CR_NAMESPACE}"
export IMAGE_NAME="${IMAGE_NAME}"
export ICR_IMAGE="${ICR_IMAGE}"

# Kubernetes settings
export KUBE_NAMESPACE="k8s-visualizer-demo"
export CLUSTER_NAME="${CLUSTER_NAME}"

# Ingress settings
export INGRESS_DOMAIN="visdemo.rst-iks-cluster-007632d2d5235aabd90e420d6faed9fd-0000.us-south.containers.appdomain.cloud"
export TLS_SECRET_NAME="k8s-visualizer-tls"
EOF

chmod +x .ibm/config.sh

echo "✅ IBM Cloud setup complete!"
echo "Configuration saved to .ibm/config.sh"
